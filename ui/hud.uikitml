<panel>
  <style>
    .root {
      background-color: rgba(0,0,0,0.75);
      border-radius: 6;
      padding: 4;
      flex-direction: row;
      gap: 8;
      align-items: center;
      justify-content: center;
      border-width: 1;
      border-color: #4488ff;
    }
    .score {
      font-size: 11;
      color: #44aaff;
      font-weight: bold;
    }
    .lives {
      font-size: 11;
      color: #ff4444;
    }
    .time {
      font-size: 11;
      color: #aaaaff;
    }
    .streak {
      font-size: 9;
      color: #ffaa00;
    }
    .mode-info {
      font-size: 9;
      color: #88ff88;
    }
  </style>
  <container class="root">
    <text class="score" id="score">Score: 0</text>
    <text class="lives" id="lives">Lives: ***</text>
    <text class="time" id="time">0:00</text>
    <text class="streak" id="streak"></text>
    <text class="mode-info" id="mode-info"></text>
  </container>
</panel>
